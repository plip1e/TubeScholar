# Copy this file to `.env` and fill in what you use. `.env` is gitignored.
# -----------------------------------------------------------------------------------------
# TubeScholar is provider-agnostic. Choose your chat + embedding models with a
# `provider:model` prefix, then set ONLY that provider's API key below.
#   chat providers:       openai:  | anthropic:  | google_genai:
#   embedding providers:  openai:  | google_genai:   (Anthropic has no embeddings API)
#
# Install your provider first if it isn't Google (which ships by default):
#   pip install -e ".[openai]"      or      pip install -e ".[anthropic]"
# -----------------------------------------------------------------------------------------

# Chat model (examples, pick one):
#   MAIN_MODEL=openai:gpt-4o
#   MAIN_MODEL=anthropic:claude-sonnet-4-5
MAIN_MODEL=google_genai:gemini-3.1-flash-lite

# Embedding model (examples, pick one; must match a provider you have a key for):
#   EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_MODEL=google_genai:models/gemini-embedding-001

# Provider API keys: set only the one(s) your models above use.
# (Chat and embeddings may use different providers, e.g. Claude chat + OpenAI embeddings.)
GOOGLE_API_KEY=      # for google_genai:* models
OPENAI_API_KEY=      # for openai:* models
ANTHROPIC_API_KEY=   # for anthropic:* chat models
# -----------------------------------------------------------------------------------------

YOUTUBE_API_KEY=     # YouTube Data API v3 key (video ingestion; unrelated to the LLM)
# -----------------------------------------------------------------------------------------

# LangSmith tracing (optional). Leave empty to disable.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# -----------------------------------------------------------------------------------------

# Webshare proxy (optional, for transcript fetching). Leave empty to disable.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# -----------------------------------------------------------------------------------------

# Storage paths (optional; sensible defaults if omitted)
# CHROMA_DIR=data/chroma_db
# CHECKPOINT_DB=data/checkpoints.sqlite

WHISPER_ENABLED=0    # 1 to enable local Whisper audio transcription
